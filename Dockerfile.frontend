# Use Node.js 18 as the base image
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application code
COPY frontend/ .

# Build the Next.js app for production
RUN npm run build

# Expose port
EXPOSE 3000

# Start the application
CMD ["npm", "start"]